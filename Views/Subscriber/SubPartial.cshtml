<div class="card border-0 shadow-lg rounded-4">
    <div class="card-body">
        <form id="subscriberForm" class="form-control">
            <div class="form-floating mb-2">
                <input id="username" class="form-control rounded-3" type="text" name="username" required/>
                <label for="username">Username</label>
            </div>

            <div class="form-floating mb-2">
                <input id="password" class="form-control rounded-3" type="password"  name="password" minlength="8" maxlength="20" required />
                <label for="password">Password</label>
            </div>

            <div class="form-floating mb-2">
                <input id="customer_name" class="form-control rounded-3" type="text" name="customer_name" required/>
                <label for="customer_name">Customer Name</label>
            </div>

            <button type="submit" class="btn btn-primary float-end mt-4" id="subFormBtn">Add</button>
        </form>
    </div>
</div>