@using KBN.Models;
@*
    For more information on enabling MVC for empty projects, visit http://go.microsoft.com/fwlink/?LinkID=397860
*@

<form>
    <div class="flex-row">
        <h6>Add DIDs range : </h6>
        <div class="mb-3">
            <input type="number" class="form-control custom-border-input" id="startrange" pattern="^\d{11}$" maxlength="11" />
            <br />
            <input type="number" class="form-control custom-border-input" id="endrange" pattern="^\d{11}$" maxlength="11" />
        </div>

        <div class="d-flex flex-column" style="height: 300px; border: 1px solid blue;">
            <textarea class="form-control flex-grow-1" style="resize: none;" id="didtextarea">

            </textarea>
        </div>
    </div>
    <br />
    <button type="button" class="btn btn-primary" id="generaterange">Generate DIDs</button>
</form>